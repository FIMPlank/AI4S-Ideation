{
  "name": "ai4s-ideation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdf.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdf.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings && prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "markdown-it": "^15.0.3",
    "markdown-it-attrs": "^5.0.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
